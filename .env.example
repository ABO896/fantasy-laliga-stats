# Copy this file to .env and adjust as needed. .env is gitignored.

# --- Scraper ---
SCRAPE_TARGET_URL=https://www.analiticafantasy.com/fantasy-la-liga/puja-ideal
MIN_ROW_COUNT=300
ROWS_PER_PAGE=100
RAW_RETENTION_DAYS=7
USER_AGENT="FantasyLaLigaStats/0.1 (personal, non-commercial, single-user tool; +https://github.com/ABO896/fantasy-laliga-stats)"

# --- Storage ---
DB_PATH=./data/fantasy.db

# --- API ---
# Loopback only by design — never set to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000
