# ---------------------------------------------------------------------------
# Local data — never leaves this machine
# ---------------------------------------------------------------------------
# SQLite database, its backups, and retained raw HTML from scrapes
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
raw_snapshots/
logs/
*.log

# Captured third-party pages used as test fixtures (see tests/fixtures/README.md).
# Everything under tests/fixtures/ is ignored except the README and the
# hand-written challenge page.
tests/fixtures/**
!tests/fixtures/
!tests/fixtures/README.md
!tests/fixtures/challenge-page.html

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# AI assistant workspace — local working notes, not part of the project
# ---------------------------------------------------------------------------
.claude/
CLAUDE.md
CLAUDE.local.md
.superpowers/
.planning/
docs/superpowers/

